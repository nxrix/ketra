{
  "name": "@nxrix/ketra",
  "version": "1.3.1",
  "description": "A JavaScript quantum computing framework inspired by Qiskit",
  "type": "module",
  "main": "./dist/ketra.js",
  "module": "./dist/ketra.js",
  "exports": {
    ".": "./dist/ketra.js"
  },
  "browser": "./dist/ketra.js",
  "unpkg": "./dist/ketra.min.js",
  "files": [
    "dist/*.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:fast": "jest"
  },
  "keywords": [
    "quantum",
    "quantum-computing",
    "quantum-circuit",
    "qiskit",
    "simulation",
    "statevector",
    "qasm",
    "vqe",
    "qaoa",
    "grover",
    "javascript",
    "esm"
  ],
  "author": "nxrix",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nxrix/ketra"
  },
  "homepage": "https://github.com/nxrix/ketra",
  "bugs": {
    "url": "https://github.com/nxrix/ketra/issues"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "babel-jest": "^29.7.0",
    "esbuild": "^0.28.1",
    "jest": "^29.7.0",
    "jsdoc": "^4.0.5"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/index.js",
      "!src/visualization/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "text-summary",
      "lcov",
      "html"
    ],
    "testMatch": [
      "<rootDir>/test/**/*.test.js"
    ],
    "moduleFileExtensions": [
      "js",
      "json"
    ]
  }
}
